/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "figa-chatbot",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-10",
	// Prepared only: no Cron triggers and the source live gate remains false.
	"durable_objects": { "bindings": [{ "name": "RINGCENTRAL_MONITOR", "class_name": "RingCentralMonitor" }] },
	"migrations": [{ "tag": "v1-ringcentral-monitor", "new_sqlite_classes": ["RingCentralMonitor"] }],
	"triggers": { "crons": [] },
	"secrets": { "required": ["RINGCENTRAL_CLIENT_ID", "RINGCENTRAL_CLIENT_SECRET", "RINGCENTRAL_JWT"] },
	"vars": {
		"RINGCENTRAL_POLLING_ENABLED": "false",
		"RINGCENTRAL_POLLING_PAUSED": "true",
		"RINGCENTRAL_POLL_INTERVAL_SECONDS": "120",
		"RINGCENTRAL_MONITORING_SECURITY_APPROVED": "false"
	},
	// No remote bindings in the default environment. Opt in with: npm run dev:ai
	"env": {
		"workers-ai": {
			"triggers": { "crons": [] },
			"ai": { "binding": "AI", "remote": true }
		},
		// PRODUCTION (prepared, not deployed). Deploys as the existing "figa-chatbot" Worker so the
		// Durable Object state carries over. Every switch below starts OFF/PAUSED; no public route.
		// Go-live order and approvals: docs/SMS_WORKFLOW.md. Secrets (never vars): wrangler secret put --env production.
		// Reviewed code locks must also be flipped: RINGCENTRAL_POLLING_LIVE_ENABLED, RINGCENTRAL_PRODUCTION_PROCESSING_ENABLED
		// (src/ringcentral/polling.ts) and RINGCENTRAL_SMS_DELIVERY_ENABLED (src/ringcentral/sms-sender.ts).
		"production": {
			"name": "figa-chatbot",
			// Public workers.dev address for the Telegram webhook ONLY (FIGA_PUBLIC_WEBHOOK_ONLY); every other path is 404.
			"workers_dev": true,
			"preview_urls": false,
			// Every minute: staff Telegram commands within ~1 minute; RingCentral polling self-limits to 120s.
			"triggers": { "crons": ["* * * * *"] },
			"durable_objects": { "bindings": [{ "name": "RINGCENTRAL_MONITOR", "class_name": "RingCentralMonitor" }] },
			"ai": { "binding": "AI" },
			// Staged go-live adds secrets step by step; productionReadiness() names any that are missing.
			"secrets": { "required": [] },
			"vars": {
				// Stage 2 (approved 2026-11-15): read real texts on extension 101, draft replies with Gemma.
				"FIGA_PRIVACY_APPROVED": "true",
				"RINGCENTRAL_MONITORING_SECURITY_APPROVED": "true",
				"RINGCENTRAL_POLLING_ENABLED": "true",
				"RINGCENTRAL_POLLING_PAUSED": "false",
				"RINGCENTRAL_POLL_INTERVAL_SECONDS": "120",
				"RINGCENTRAL_ACCOUNT_ID": "3322425015",
				// FIGA business numbers on extension 101 (public); replies go out from the number the customer texted.
				"RINGCENTRAL_SMS_NUMBERS": "+15039057215,+15039051648",
				// Sending ON (approved). Replies go out only when staff set Away/Auto in Telegram; Paused/On Duty send nothing.
				"RINGCENTRAL_SMS_SENDING_ENABLED": "true",
				// One RingCentral app ("FIGA Chatbot Read-Only") holds exactly Read Messages + SMS.
				"RINGCENTRAL_APP_HAS_SMS": "true",
				// One-time operator action: the app gained SMS, which (correctly) blocked the read-only reader; reviewed and cleared.
				"RINGCENTRAL_AUTH_REVIEW_CLEARED": "2026-11-15-app-gained-sms",
				"RINGCENTRAL_OFFLINE_ENABLED": "false",
				"AI_GLOBAL_PAUSED": "false",
				"AI_ENABLED": "true",
				"AI_PROVIDER": "workers-ai",
				"AI_ALLOW_SYNTHETIC_REQUESTS": "false",
				"AI_PRODUCTION_DATA_APPROVED": "true",
				"AI_TIMEOUT_MS": "8000",
				"SUPABASE_ENABLED": "false",
				// Stage 1: separate production project (never the development project).
				"SUPABASE_PRODUCTION_ENABLED": "true",
				"SUPABASE_PRODUCTION_PROJECT_REF": "aahxrxfwmtoswxjnlbal",
				"SUPABASE_PRODUCTION_URL": "https://aahxrxfwmtoswxjnlbal.supabase.co",
				// Stage 1: staff controls via Telegram polling (inert until the token secret exists).
				"TELEGRAM_STAFF_ENABLED": "true",
				"TELEGRAM_LIVE_ENABLED": "true",
				"TELEGRAM_POLLING_ENABLED": "true",
				// Instant buttons: Telegram pushes updates to the webhook (secret-protected); the bot registers it itself.
				"TELEGRAM_WEBHOOK_ENABLED": "true",
				"TELEGRAM_WEBHOOK_URL": "https://figa-chatbot.figawllc.workers.dev/telegram/webhook",
				"FIGA_PUBLIC_WEBHOOK_ONLY": "true"
			}
		}
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
