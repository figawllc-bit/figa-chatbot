{
  "name": "figa-chatbot",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "dev:ai": "wrangler dev --env workers-ai --env-file .dev.vars --ip 127.0.0.1 --port 8787",
    "start": "wrangler dev",
    "test": "vitest",
    "test:run": "vitest run",
    "test:database": "node --test database-tests/*.test.mjs",
    "demo:telegram": "node scripts/telegram-demo.mjs",
    "telegram:test": "node scripts/telegram-test.mjs",
    "telegram:notification:test": "node scripts/telegram-notification-test.mjs",
    "telegram:poll": "node scripts/telegram-poll.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "preflight": "node scripts/production-preflight.mjs",
    "production:sql": "node scripts/production-sql.mjs",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "supabase": "^3.1.0",
    "typescript": "^5.5.2",
    "vitest": "~5.0.3",
    "wrangler": "^4.161.0"
  }
}
